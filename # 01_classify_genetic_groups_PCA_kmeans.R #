
library(dplyr)
library(ggplot2)
set.seed(123)

# ============================================================
# 1. Carregar entradas organizadas
# ============================================================
entrada <- readRDS("sim_inputs_real.rds")
matriz_marcadores <- entrada$matriz_marcadores

# ============================================================
# 2. Preparar matriz para PCA
# ============================================================
cat("\nPreparando matriz para PCA...\n")
matriz_pca <- matriz_marcadores
variancia_marcadores <- apply(
  matriz_pca,
  2,
  var,
  na.rm = TRUE
)

marcadores_validos <- names(variancia_marcadores)[
  is.finite(variancia_marcadores) &
    variancia_marcadores > 0
]

matriz_pca <- matriz_pca[
  ,
  marcadores_validos,
  drop = FALSE
]

cat("\nMarcadores usados na PCA:\n")
cat(ncol(matriz_pca), "\n")

# ============================================================
# 3. Rodar PCA
# ============================================================
cat("\nRodando PCA...\n")
pca_resultado <- prcomp(
  matriz_pca,
  center = TRUE,
  scale. = TRUE,
  rank. = 10
)

variancia_pca <- data.frame(
  PC = paste0("PC", seq_along(pca_resultado$sdev)),
  Variancia_percentual = (pca_resultado$sdev^2 / sum(pca_resultado$sdev^2)) * 100
)

cat("\nVariância explicada pelos primeiros componentes:\n")
print(head(variancia_pca, 10))

scores_pca <- as.data.frame(pca_resultado$x)
scores_pca$Linhagem <- rownames(matriz_pca)
scores_pca <- scores_pca %>%
  dplyr::select(Linhagem, dplyr::everything())

# ============================================================
# 4. Definir dois grupos genéticos operacionais
# ============================================================
cat("\nClassificando dois grupos genéticos operacionais...\n")

k_grupos <- 2
kmeans_grupos <- kmeans(
  scores_pca[, c("PC1", "PC2")],
  centers = k_grupos,
  nstart = 100
)

scores_pca$Cluster_k2 <- as.factor(kmeans_grupos$cluster)
tabela_clusters <- table(scores_pca$Cluster_k2)
cat("\nTamanho dos clusters iniciais:\n")
print(tabela_clusters)

cluster_selecao <- names(which.max(tabela_clusters))
cluster_testador <- names(which.min(tabela_clusters))

scores_pca <- scores_pca %>%
  dplyr::mutate(
    Grupo_operacional = ifelse(
      Cluster_k2 == cluster_selecao,
      "Grupo_selecao_recorrente",
      "Grupo_oposto_testador"
    )
  ) %>%
  dplyr::mutate(
    Grupo = ifelse(
      Grupo_operacional == "Grupo_selecao_recorrente",
      "B",
      "A"
    )
  )

cat("\nResumo dos grupos operacionais:\n")
print(table(scores_pca$Grupo_operacional))

cat("\nResumo dos grupos A/B:\n")
print(table(scores_pca$Grupo))

# ============================================================
# 5. Calcular centroides dos grupos
# ============================================================

cat("\nCalculando centroides dos grupos operacionais...\n")

centroides_grupos <- scores_pca %>%
  dplyr::group_by(Grupo, Grupo_operacional) %>%
  dplyr::summarise(
    PC1_centroide = mean(PC1),
    PC2_centroide = mean(PC2),
    n_linhagens = dplyr::n(),
    .groups = "drop"
  )

cat("\nCentroides dos grupos operacionais:\n")
print(centroides_grupos)

# ============================================================
# 6. Selecionar testadores via PCA dentro do grupo oposto
# ============================================================

cat("\nSelecionando testadores via PCA...\n")

dados_grupo_testador <- scores_pca %>%
  dplyr::filter(Grupo_operacional == "Grupo_oposto_testador")

if (nrow(dados_grupo_testador) < 3) {
  stop("O grupo oposto/testador possui menos de 3 linhagens.")
}

k_testadores <- 3

kmeans_testadores <- kmeans(
  dados_grupo_testador[, c("PC1", "PC2")],
  centers = k_testadores,
  nstart = 100
)

dados_grupo_testador$Subgrupo_testador <- as.factor(kmeans_testadores$cluster)

centroides_testadores <- as.data.frame(kmeans_testadores$centers)

centroides_testadores$Subgrupo_testador <- as.factor(
  seq_len(nrow(centroides_testadores))
)

colnames(centroides_testadores)[1:2] <- c(
  "PC1_centroide_subgrupo",
  "PC2_centroide_subgrupo"
)

dados_grupo_testador <- dados_grupo_testador %>%
  dplyr::left_join(
    centroides_testadores,
    by = "Subgrupo_testador"
  ) %>%
  dplyr::mutate(
    Distancia_centroide = sqrt(
      (PC1 - PC1_centroide_subgrupo)^2 +
        (PC2 - PC2_centroide_subgrupo)^2
    )
  )

testadores_selecionados <- dados_grupo_testador %>%
  dplyr::group_by(Subgrupo_testador) %>%
  dplyr::slice_min(
    order_by = Distancia_centroide,
    n = 1,
    with_ties = FALSE
  ) %>%
  dplyr::ungroup() %>%
  dplyr::arrange(Subgrupo_testador) %>%
  dplyr::mutate(
    Tipo = "Testador_representativo_via_PCA"
  ) %>%
  dplyr::select(
    Linhagem,
    Grupo,
    Grupo_operacional,
    Subgrupo_testador,
    PC1,
    PC2,
    Distancia_centroide,
    Tipo
  )

cat("\nTestadores selecionados:\n")
print(testadores_selecionados)

# ============================================================
# 7. Adicionar informação de testador na tabela principal
# ============================================================

scores_pca <- scores_pca %>%
  dplyr::mutate(
    Testador_selecionado = ifelse(
      Linhagem %in% testadores_selecionados$Linhagem,
      "Sim",
      "Nao"
    )
  )



# ============================================================
#  Salvar objeto completo
# ============================================================

resultado_grupos <- list(
  
  matriz_usada_PCA = matriz_pca,
  
  pca_resultado = pca_resultado,
  
  variancia_pca = variancia_pca,
  
  scores_pca = scores_pca,
  
  kmeans_grupos = kmeans_grupos,
  
  centroides_grupos = centroides_grupos,
  
  dados_grupo_testador = dados_grupo_testador,
  
  kmeans_testadores = kmeans_testadores,
  
  centroides_testadores = centroides_testadores,
  
  testadores_selecionados = testadores_selecionados
)

saveRDS(
  resultado_grupos,
  "resultado_grupos_geneticos_e_testadores.rds"
)
